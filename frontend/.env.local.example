# BHA Platform — Frontend Environment Variables
# Copy to .env.local and fill in real values

# Flask backend URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:5000

# PromptPay payment details (shown on /payment page)
# QR image: place file at frontend/public/promptpay-qr.png
NEXT_PUBLIC_PROMPTPAY_NUMBER=XXX-XXX-7890
NEXT_PUBLIC_PROMPTPAY_NAME=Northstar Corporation
