# BHA Platform — Backend Environment Variables
# Copy to .env and fill in real values before running in production

# Flask secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Admin panel token — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me-to-a-random-token

# Anthropic API key — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# SQLite DB path (default: bha.db in current directory)
DB_PATH=bha.db

# Flask environment: "development" or "production"
FLASK_ENV=production

# Allowed CORS origins (comma-separated, no trailing slash)
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app

# Slip upload folder path
UPLOAD_FOLDER=slips

# ── Branding & contact (shown in the PDF report + emails) ──────────
BHA_BRAND_NAME=AA · Agentic-Auditor
BHA_CONTACT_EMAIL=agenticauditor24@gmail.com
BHA_CONTACT_WEB=www.agentic-auditor.com/bha

# ── Email (SendGrid) ──────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@agentic-auditor.com
FRONTEND_URL=https://www.agentic-auditor.com

# ── Logging / validation ──────────────────────────────────────────
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR (default INFO)
LOG_LEVEL=INFO
# BHA_STRICT_VALIDATION=1 makes report generation raise on HIGH invariant
# violations (use in CI/staging). Leave unset/0 in prod (fail-soft).
BHA_STRICT_VALIDATION=0
